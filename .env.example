# Contoh konfigurasi environment.
# Salin berkas ini menjadi .env lalu isi nilai sebenarnya.
# Jangan pernah commit .env. Nilai di bawah hanya placeholder.

# ── Aplikasi ─────────────────────────────────────────────
PORT=3002
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Database ─────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# ── Autentikasi ──────────────────────────────────────────
JWT_SECRET=your_random_jwt_secret

# ── Layanan eksternal ────────────────────────────────────
GEO_API_URL=https://example.com/geo
